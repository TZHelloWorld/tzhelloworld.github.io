        <mxCell id="ItM7w5jBBf7xTvinht4W-177" value="&lt;div style=&quot;color: rgb(169, 183, 198);&quot;&gt;&lt;pre style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace;&quot;&gt;&lt;pre style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace;&quot;&gt;&lt;div style=&quot;color: rgb(171, 178, 191); font-family: &amp;quot;Droid Sans Mono&amp;quot;, &amp;quot;monospace&amp;quot;, monospace; line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;font-size: 16px; line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;&lt;span style=&quot;color: rgb(198, 120, 221);&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: rgb(97, 175, 239);&quot;&gt;alloc_for_decode&lt;/span&gt;(...):&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #c678dd;&quot;&gt;if&lt;/span&gt; batch.tree_cache.page_size &lt;span style=&quot;color: #56b6c2;&quot;&gt;==&lt;/span&gt; &lt;span style=&quot;color: #d19a66;&quot;&gt;1&lt;/span&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;        &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;# Non-paged allocation&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;        &lt;span style=&quot;color: #e06c75;&quot;&gt;out_cache_loc&lt;/span&