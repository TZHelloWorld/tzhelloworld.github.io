gt;&lt;span&gt;    &lt;span style=&quot;color: #e5c07b;font-style: italic;&quot;&gt;self&lt;/span&gt;.input_ids &lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt; torch.&lt;span style=&quot;color: #61afef;&quot;&gt;empty&lt;/span&gt;(&lt;span style=&quot;color: #d19a66;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;dtype&lt;/span&gt;&lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt;torch.int64, &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;device&lt;/span&gt;&lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #e5c07b;font-style: italic;&quot;&gt;self&lt;/span&gt;.device)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e5c07b;font-style: italic;&quot;&gt;self&lt;/span&gt;.seq_lens &lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt; torch.&lt;span style=&quot;color: #61afef;&quot;&gt;empty&lt;/span&gt;(&lt;span style=&quot;color: #d19a66;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;dtype&lt;/span&gt;&lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt;torch.int64, &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;device&lt;/span&gt;&lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #e5c07b;font-style: italic;&quot;&gt;self&lt;/span&gt;.device)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e5c07b;font-style: italic;&quot;&gt;self&lt;/span&gt;.seq_lens_cpu &lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt; torch.&lt;span style=&quot;color: #61afef;&quot;&gt;empty&lt;/span&gt;(&lt;span style=&quot;color: #d19a66;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;dtype&lt;/span&gt;&lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt;torch.int64)&lt;/span&gt;&lt;/div&gt;&lt;div style=&q