;            &lt;span style=&quot;color: #c678dd;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #e5c07b;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #e06c75;&quot;&gt;mamba_track_indices&lt;/span&gt; &lt;span style=&quot;color: #c678dd;&quot;&gt;is&lt;/span&gt; &lt;span style=&quot;color: #c678dd;&quot;&gt;not&lt;/span&gt; &lt;span style=&quot;color: #d19a66;&quot;&gt;None&lt;/span&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;                &lt;span style=&quot;color: #e5c07b;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #e06c75;&quot;&gt;mamba_track_indices&lt;/span&gt;.&lt;span style=&quot;color: #61afef;&quot;&gt;zero_&lt;/span&gt;()&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;            &lt;span style=&quot;color: #c678dd;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #e5c07b;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #e06c75;&quot;&gt;mamba_track_mask&lt;/span&gt; &lt;span style=&quot;color: #c678dd;&quot;&gt;is&lt;/span&gt; &lt;span style=&quot;color: #c678dd;&quot;&gt;not&lt;/span&gt; &lt;span style=&quot;color: #d19a66;&quot;&gt;None&lt;/span&gt;:&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;                &lt;span style=&quot;color: #e5c07b;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #e06c75;&quot;&gt;mamba_track_mask&lt;/span&gt;.&lt;span style=&quot;color: #61afef;&quot;&gt;fill_&lt;/span&gt;(&lt;span style=&quot;color: #d19a66;&quot;&gt;False&lt;/span&gt;)&lt;/span&gt;&lt;/div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;        &lt;span style=&quot;color: #7f848e;font-style: italic;&quot;&gt;# Common inputs&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;        &lt;span style=&quot;color: #e5c07b;font-style: italic;&quot;&gt;self&lt;/span&gt;.&lt;span style=&quot;color: #e06c75;&quot