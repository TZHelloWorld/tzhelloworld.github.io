        <mxCell id="Ymp7YCRm9gtUtqxPTq4i-225" value="&lt;span style=&quot;font-size: 20px;&quot;&gt;注意，这里如果使用 draft_worker，会传入这个 tp_worker 作为 target_worker&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="Ymp7YCRm9gtUtqxPTq4i-226" vertex="1">
