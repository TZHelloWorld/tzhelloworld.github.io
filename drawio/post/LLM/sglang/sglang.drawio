        <mxCell id="3lTbVvvX1QdQyiJ4gLGc-2" value="&lt;div style=&quot;color: rgb(169, 183, 198);&quot;&gt;&lt;pre style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace;&quot;&gt;&lt;pre style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace;&quot;&gt;&lt;div style=&quot;color: rgb(171, 178, 191); font-family: &amp;quot;Droid Sans Mono&amp;quot;, &amp;quot;monospace&amp;quot;, monospace; line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;font-size: 16px; line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;line-height: 22px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;&lt;span style=&quot;color: rgb(198, 120, 221);&quot;&gt;def&lt;/span&gt; &lt;span style=&quot;color: rgb(97, 175, 239);&quot;&gt;normal_decode_set_metadata&lt;/span&gt;(&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;cache_seqlens_int32&lt;/span&gt;: torch.Tensor,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;cu_seqlens_k&lt;/span&gt;: torch.Tensor,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;page_table&lt;/span&gt;: torch.Tensor,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;req_to_token&lt;/span&gt;: torch.Tensor,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;req_pool_indices&lt;/span&gt;: torch.Tensor,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;strided_indices&lt;/span&gt;: torch.Tensor,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;max_seq_pages&lt;/span&gt;: torch.Tensor,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;seq_lens&lt;/span&gt;: torch.Tensor,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;seq_len_delta&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;int&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;page_size&lt;/span&gt;: &lt;span style=&quot;color: #e5c07b;&quot;&gt;int&lt;/span&gt;,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;):&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;cache_seqlens_int32&lt;/span&gt;.&lt;span style=&quot;color: #61afef;&quot;&gt;copy_&lt;/span&gt;(&lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;seq_lens&lt;/span&gt; &lt;span style=&quot;color: #56b6c2;&quot;&gt;+&lt;/span&gt; &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;seq_len_delta&lt;/span&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;cu_seqlens_k&lt;/span&gt;[&lt;span style=&quot;color: #d19a66;&quot;&gt;1&lt;/span&gt;:].&lt;span style=&quot;color: #61afef;&quot;&gt;copy_&lt;/span&gt;(torch.&lt;span style=&quot;color: #61afef;&quot;&gt;cumsum&lt;/span&gt;(&lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;cache_seqlens_int32&lt;/span&gt;, &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;dim&lt;/span&gt;&lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #d19a66;&quot;&gt;0&lt;/span&gt;, &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;dtype&lt;/span&gt;&lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt;torch.int32))&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;&quot;&gt;page_indices&lt;/span&gt; &lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;req_to_token&lt;/span&gt;[&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;        &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;req_pool_indices&lt;/span&gt;[:, &lt;span style=&quot;color: #d19a66;&quot;&gt;None&lt;/span&gt;],&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;        &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;strided_indices&lt;/span&gt;[:&lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;max_seq_pages&lt;/span&gt;][&lt;span style=&quot;color: #d19a66;&quot;&gt;None&lt;/span&gt;, :],&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    ]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;    &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;page_table&lt;/span&gt;[:, :&lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;max_seq_pages&lt;/span&gt;].&lt;span style=&quot;color: #61afef;&quot;&gt;copy_&lt;/span&gt;(&lt;span style=&quot;color: #e06c75;&quot;&gt;page_indices&lt;/span&gt; &lt;span style=&quot;color: #56b6c2;&quot;&gt;//&lt;/span&gt; &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;page_size&lt;/span&gt;)&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;/pre&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#282C34;container=0;" vertex="1" parent="3lTbVvvX1QdQyiJ4gLGc-28">
