c75;&quot;&gt;input_embeds&lt;/span&gt; &lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt; torch.&lt;span style=&quot;color: #61afef;&quot;&gt;zeros&lt;/span&gt;((&lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;max_num_token&lt;/span&gt;, &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;hidden_size&lt;/span&gt;), &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;dtype&lt;/span&gt;&lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;dtype&lt;/span&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;            &lt;span style=&quot;color: #e06c75;&quot;&gt;req_pool_indices&lt;/span&gt; &lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt; torch.&lt;span style=&quot;color: #61afef;&quot;&gt;zeros&lt;/span&gt;((&lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;max_bs&lt;/span&gt;,), &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;dtype&lt;/span&gt;&lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt;torch.int32)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;            &lt;span style=&quot;color: #e06c75;&quot;&gt;seq_lens&lt;/span&gt; &lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt; torch.&lt;span style=&quot;color: #61afef;&quot;&gt;full&lt;/span&gt;((&lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;max_bs&lt;/span&gt;,), &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;seq_len_fill_value&lt;/span&gt;, &lt;span style=&quot;color: #e06c75;font-style: italic;&quot;&gt;dtype&lt;/span&gt;&lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt;torch.int32)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span&gt;            &lt;span style=&quot;color: #e06c75;&quot;&gt;out_cache_loc&lt;/span&gt; &lt;span style=&quot;color: #56b6c2;&quot;&gt;=&lt;/span&gt; torch.&lt;span style=&quot;color: #61afef;&quot;&gt